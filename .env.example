# Tuloy API configuration. Copy to .env (git-ignored) and fill in. Never commit real values.
# Real environment variables override this file. TULOY_ENV_FILE="" disables reading it.

# ---- Environment ----------------------------------------------------------
# Required, no default: local | dev | uat | staging | prod. Outside local/dev the API refuses to
# start with: a missing SECRET_KEY, ALLOW_SIGNUP=true, CORS_ORIGINS=*, TRUSTED_HOSTS empty or *,
# a non-TLS REDIS_URL, and
# MIGRATION_DB_USER equal to DB_USER.
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Database (MySQL 8) -----------------------------------------------------
# The schema holds the ODS views (vw_verify_member_bene, vw_get_matched_CHED; read through
# READ ONLY sessions) and the application tables (api_users, matching_transaction_CHED_tbl,
# enroll_matched_CHED_tbl). With SSH_HOST set, DB_HOST/DB_PORT are resolved from the bastion.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
# Runtime account. Least privilege: SELECT on the views and app tables; INSERT on
# api_users (only if signup is used), matching_transaction_CHED_tbl, enroll_matched_CHED_tbl.
DB_USER=
DB_PASSWORD=
# Optional separate account for the write pool (INSERT on the three app tables only).
# Empty = the write pool uses DB_USER. Recommended outside local; see docs/PRODUCTION_READINESS.md.
DB_RW_USER=
DB_RW_PASSWORD=
# Optional CA bundle for verified TLS to MySQL. Leave empty for a normal connector connection
# without certificate verification. With SSH_HOST set, the host name isn't checked.
DB_SSL_CA=
# Set false only for an IP-addressed MySQL with its auto-generated certificate (chain still checked).
DB_SSL_VERIFY_IDENTITY=true
DB_CONNECT_TIMEOUT=10
# Server-side SELECT limit per statement (MySQL max_execution_time), milliseconds.
DB_QUERY_TIMEOUT_MS=15000
# Read-only pool size; the write pool is half of it. Connections per process = size * 1.5.
DB_POOL_SIZE=4

# DDL account used only by scripts/migrate.py (never by the API). Leave empty locally if unused.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# ---- SSH bastion (optional) -----------------------------------------------
# When SSH_HOST is set the API opens its own tunnel: local end on 127.0.0.1 (ephemeral port),
# host key verified against SSH_KNOWN_HOSTS (mandatory), only the password/key below offered.
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Set one of the two. A key is preferred over a password.
SSH_PASSWORD=
SSH_PKEY=
SSH_KNOWN_HOSTS=~/.ssh/known_hosts
SSH_KEEPALIVE_SECONDS=30

# ---- Authentication -------------------------------------------------------
# At least 32 random characters; required outside local. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Locally an empty value gives a random per-process key (tokens die on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=tuloy-api
JWT_AUDIENCE=tuloy-api
# Open self-registration at POST /signup. Local/dev only.
ALLOW_SIGNUP=false

# ---- HTTP -------------------------------------------------------------------
# Comma-separated Host header allowlist. Required outside local/dev and may not contain *.
# A load balancer health check must send one of these hosts.
TRUSTED_HOSTS=127.0.0.1,localhost
# Comma-separated browser origins; empty = no CORS headers (server-to-server callers only).
CORS_ORIGINS=
# Per client IP per minute, in-process (each worker counts separately). Behind a proxy every
# caller shares the proxy's IP unless uvicorn runs with --proxy-headers and FORWARDED_ALLOW_IPS
# set to the proxy address. The CSV import and a web-app backend make many calls from one IP:
# raise this for them, or exempt them at the gateway. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=120
# /docs, /openapi.json. Defaults to true in local/dev, false elsewhere.
EXPOSE_DOCS=

# ---- Cache ------------------------------------------------------------------
# Empty = in-memory cache. Responses cached here contain personal data: use an
# authenticated, TLS-protected Redis (rediss://) that only this API can reach.
REDIS_URL=
CACHE_EXPIRE_SECONDS=1200

# ---- Partner API (/v1/api/tuloy) -------------------------------------------
# Mounts the six Partner operations. They authenticate and authorize, then answer 501
# until each contract is approved (docs/PARTNER_API_CONTRACT.md).
PARTNER_API_ENABLED=false

# ---- Tools --------------------------------------------------------------------
# scripts/smoke.py: optional test account for the authenticated read check.
SMOKE_USERNAME=
SMOKE_PASSWORD=
# others/import_ched_csv.py: existing API user for the CSV import (posts real data; DPO approval first).
IMPORT_API_USERNAME=
IMPORT_API_PASSWORD=

# Staff SSO is opt-in; service /token remains available independently.
STAFF_AUTH_MODE=legacy
# Local Docker: enable keycloak mode and match the local client audience.
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/dswd4ps
KEYCLOAK_API_AUDIENCE=tuloy-api-local
# Staging: HTTPS institutional issuer, audience tuloy-api-staging.
# CORS_ORIGINS must include the exact frontend origin. No passwords or client secret needed for SSO.

# Temporary full access for every enabled TULOY SSO staff identity, including
# identities registered on first login. API setting only; never prefix with VITE_.
# Applies to supported staff web operations; settings writes still require
# SETTINGS_WRITE_ENABLED. NAPA creation remains service-only. It does not
# add missing module endpoints or open service-only partner/import routes.
# Defaults off. Startup rejects true outside APP_ENV=local/staging or without
# STAFF_AUTH_MODE=keycloak. Restart the API after changing it. No grant rows are written.
STAFF_FULL_ACCESS_ENABLED=false
